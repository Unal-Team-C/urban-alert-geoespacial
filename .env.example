# Copy to .env for local use. Local-only example values; never commit .env.

# Database container
POSTGRES_USER=geospatial
POSTGRES_PASSWORD=geospatial
POSTGRES_DB=geospatial

# Service
DATABASE_URL=postgresql://geospatial:geospatial@db:5432/geospatial
DB_POOL_MIN=5
DB_POOL_MAX=50
MAX_RADIUS_M=6000

# Bogotá bounding box (Distrito Capital incl. Sumapaz)
BOGOTA_MIN_LAT=3.72
BOGOTA_MAX_LAT=4.84
BOGOTA_MIN_LON=-74.46
BOGOTA_MAX_LON=-73.98
